# Copie este arquivo para .env e preencha os valores.
# Arquivos .env reais nunca são versionados.
#
# Atenção: tudo com prefixo EXPO_PUBLIC_ é embarcado no pacote do aplicativo e
# é legível por qualquer pessoa que tenha o APK. Nunca coloque aqui a chave
# service_role do Supabase nem qualquer outro segredo de servidor.

# Estágio do build: development, preview ou production.
EXPO_PUBLIC_APP_STAGE=development

# Projeto Supabase. Passa a ser exigido a partir da fase de autenticação.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
